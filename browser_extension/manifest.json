{
  "manifest_version": 3,
  "name": "Deepfake Detector & Analyzer",
  "version": "4.0",
  "description": "Upload, drag-drop, or snip media to detect deepfakes using AI. Right-click media for quick analysis.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepfake Detector",
    "default_icon": "deepfake.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "deepfake_logo.jpeg"
  }
}
